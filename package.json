{
  "name": "waygo",
  "version": "0.1.0",
  "description": "Google Maps public transit directions in your terminal",
  "license": "MIT",
  "author": "Ryan George",
  "keywords": [
    "cli",
    "google-maps",
    "transit",
    "directions",
    "public-transport",
    "routes-api",
    "places-api"
  ],
  "bin": {
    "waygo": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "unbuild",
    "build:bin": "bun build --compile src/index.ts --outfile dist/waygo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "c12": "^4.0.0-beta.2",
    "citty": "^0.2.1",
    "date-fns": "^4.1.0",
    "ofetch": "^1.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "knip": "^6.14.2",
    "lefthook": "^2.1.1",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
